NAME		= push_swap
CC			= cc
CFLAGS		= -Wall -Wextra -Werror
CPPFLAGS	= -Iheader

SRC_DIR		= src
SRCS		= push_swap.c operation.c sort_a.c sort_b.c sort_utils.c \
			  parsing1.c parsing2.c ft_split.c
OBJS		= $(addprefix $(SRC_DIR)/,$(SRCS:.c=.o))

all: $(NAME)

$(NAME): $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $(NAME)

$(SRC_DIR)/%.o: $(SRC_DIR)/%.c
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
